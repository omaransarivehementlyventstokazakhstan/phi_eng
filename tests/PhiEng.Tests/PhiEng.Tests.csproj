<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PhiEng.Math\PhiEng.Math.csproj" />
    <ProjectReference Include="..\..\src\PhiEng.Collision\PhiEng.Collision.csproj" />
    <ProjectReference Include="..\..\src\PhiEng.Broadphase\PhiEng.Broadphase.csproj" />
    <ProjectReference Include="..\..\src\PhiEng.Dynamics\PhiEng.Dynamics.csproj" />
    <ProjectReference Include="..\..\src\PhiEng.Native\PhiEng.Native.csproj" />
  </ItemGroup>

  <!-- Stage the Rust-built native library next to the test binaries so
       P/Invoke resolves phieng at runtime. Rebuild it with
       cargo build using the windows-gnu target, then copy the DLL here. -->
  <ItemGroup>
    <None Include="..\..\native\win-x64\phieng.dll" Link="phieng.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
